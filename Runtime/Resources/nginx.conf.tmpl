# Generated by Inkspire Control Panel. Edits are overwritten when settings change; use Settings instead.
worker_processes  1;
error_log  logs/error.log warn;
pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout  65;
    server_tokens off;
    charset utf-8;

    # Uploads: print files can be large. The app enforces its own (smaller) limit from Admin > Settings.
    client_max_body_size {{MAX_BODY_MB}}M;
    client_body_timeout 300s;
    send_timeout 300s;

    # The panel polls /up every few seconds; keep that out of the access log.
    map $request_uri $loggable {
        ~^/up(\?|$)  0;
        default      1;
    }
    access_log  logs/access.log combined if=$loggable;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # php-cgi on Windows serves one request at a time: send each request to the worker with the fewest open
    # connections instead of strict round-robin, so requests never queue behind a busy (or recycling) worker.
    upstream inkspire_php {
        least_conn;
{{UPSTREAM_SERVERS}}
    }

    server {
        listen       0.0.0.0:{{PORT}};
        server_name  _;
        root         "{{APP_PUBLIC}}";
        index        index.php;

        # Vite output: hashed file names, safe to cache for a year.
        location ^~ /build/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # Everything else goes to a real file if there is one, otherwise to Laravel. That includes the signed
        # /storage/... URLs of the app's private "local" disk, which Laravel itself serves: do NOT add a static-file
        # location or a /storage alias here that answers 404 for them.
        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }

        # Only Laravel's front controller may run PHP. An uploaded .php file can never execute.
        location = /index.php {
            fastcgi_pass   inkspire_php;
            fastcgi_next_upstream error timeout;
            fastcgi_read_timeout 300s;
            fastcgi_send_timeout 300s;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
            include        fastcgi_params;
            fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        }

        location ~ \.php$ {
            return 404;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
